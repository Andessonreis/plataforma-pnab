generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  PROPONENTE
  ATENDIMENTO
  HABILITADOR
  AVALIADOR
  ADMIN
}

enum TipoProponente {
  PF
  MEI
  PJ
  COLETIVO
}

enum EditalStatus {
  RASCUNHO
  PUBLICADO
  INSCRICOES_ABERTAS
  INSCRICOES_ENCERRADAS
  HABILITACAO
  AVALIACAO
  RESULTADO_PRELIMINAR
  RECURSO
  RESULTADO_FINAL
  ENCERRADO
}

enum InscricaoStatus {
  RASCUNHO
  ENVIADA
  HABILITADA
  INABILITADA
  EM_AVALIACAO
  RESULTADO_PRELIMINAR
  RECURSO_ABERTO
  RESULTADO_FINAL
  CONTEMPLADA
  NAO_CONTEMPLADA
  SUPLENTE
}

enum AtendimentoStatus {
  ABERTO
  EM_ATENDIMENTO
  FECHADO
}

enum FuncaoEdital {
  AVALIADOR
  HABILITADOR
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum CampaignType {
  MANUAL
  REGRA
}

enum CampaignStatus {
  RASCUNHO
  ENVIANDO
  ENVIADA
  CANCELADA
  FALHA
}

enum NotificationRuleTrigger {
  INSCRICAO_RASCUNHO_PENDENTE
  EDITAL_PUBLICADO
  INSCRICAO_INABILITADA
  INSCRICAO_ANEXOS_FALTANDO
  RESULTADO_PUBLICADO
  ATENDIMENTO_RESPONDIDO
  USER_SEM_INSCRICAO
  EDITAL_PRAZO_ENCERRANDO
  RECURSO_PRAZO_ENCERRANDO
}

// ─────────────────────────────────────────────────────────────────────────────
// Usuários
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  password       String
  role           UserRole        @default(PROPONENTE)
  nome           String
  cpfCnpj        String?         @unique
  tipoProponente TipoProponente?
  telefone       String?
  cep            String?
  logradouro     String?
  numero         String?
  complemento    String?
  bairro         String?
  cidade         String?
  uf             String?         @db.Char(2)
  avatarUrl      String?
  ativo          Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  inscricoes            Inscricao[]
  avaliacoes            Avaliacao[]
  recursoRespostas      RecursoResposta[]
  atendimentos          Atendimento[]
  passwordResetTokens   PasswordResetToken[]
  auditLogs             AuditLog[]
  apiKeys               ApiKey[]
  editalMembros         EditalMembro[]
  notifications         Notification[]
  notificationCampaigns NotificationCampaign[] @relation("CampaignCreatedBy")
  notificationRules     NotificationRule[]     @relation("RuleCreatedBy")
  emailTemplateEdits    EmailTemplateOverride[] @relation("EmailTemplateUpdatedBy")
}

// ─────────────────────────────────────────────────────────────────────────────
// API Keys — Autenticação para consumidores externos
// ─────────────────────────────────────────────────────────────────────────────

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  label      String
  keyHash    String    @unique // SHA-256 da chave
  prefix     String // primeiros 12 caracteres (ex: pnab_abc12345)
  scopes     String[]
  revokedAt  DateTime?
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Recuperação de Senha
// ─────────────────────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// Auditoria
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // LOGIN, LOGOUT, CADASTRO, INSCRICAO_CRIADA, STATUS_ALTERADO, EDITAL_PUBLICADO, etc.
  entity    String? // User, Inscricao, Edital, etc.
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Log de erros técnicos (exceptions capturadas em runtime)
// "Sentry-lite" self-hosted — captureError() persiste aqui.
// ─────────────────────────────────────────────────────────────────────────────

model ErrorLog {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  level       String // 'error' | 'warn'
  message     String
  stack       String?  @db.Text
  fingerprint String // hash pra agrupar erros iguais
  requestId   String?
  userId      String?
  path        String? // /api/admin/editais
  method      String? // GET, POST, ...
  statusCode  Int?
  userAgent   String?
  ip          String?
  context     Json? // extras sanitizados (sem PII)

  @@index([timestamp])
  @@index([fingerprint])
  @@index([level, timestamp])
}

// ─────────────────────────────────────────────────────────────────────────────
// Newsletter
// ─────────────────────────────────────────────────────────────────────────────

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Banners
// ─────────────────────────────────────────────────────────────────────────────

model Banner {
  id        String   @id @default(cuid())
  titulo    String
  texto     String
  ctaLabel  String?
  ctaUrl    String?
  ativo     Boolean  @default(true)
  inicioEm  DateTime
  fimEm     DateTime
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Editais
// ─────────────────────────────────────────────────────────────────────────────

model Edital {
  id                        String       @id @default(cuid())
  titulo                    String
  slug                      String       @unique
  ano                       Int
  status                    EditalStatus @default(RASCUNHO)
  resumo                    String?
  valorTotal                Decimal?     @db.Decimal(12, 2)
  categorias                String[]
  // Vagas/cotas/valor por categoria (opcional — ausente = categorias tratadas
  // só como rótulo, sem corte por categoria no resultado).
  // [{ nome, vagasAmplaConcorrencia: number|null, cotas: [{key,label,vagas}], valorPorProjeto: number|null, valorTotalCategoria: number }]
  categoriasConfig          Json?
  acoesAfirmativas          String?
  regrasElegibilidade       String?
  // Tipos de proponente aceitos (vazio = todos): PF, MEI, PJ, COLETIVO
  tiposProponentePermitidos String[]     @default([])
  // Array de marcos: [{ label: string, dataHora: string, destaque?: boolean }]
  cronograma                Json         @default("[]")
  // Definição dinâmica dos campos do formulário de inscrição (etapa "Dados")
  camposFormulario          Json         @default("[]")
  // Etapas customizadas adicionais do wizard de inscrição (além de categoria/dados/anexos/revisão).
  // Renderizadas entre "dados" e "anexos" na ordem definida.
  // [{ id: string, titulo: string, descricao?: string, ordem: number, campos: CampoFormulario[] }]
  etapasCustomizadas        Json         @default("[]")
  // Critérios de avaliação: [{ criterio: string, peso: number, descricao?: string, notaMax: number }]
  criteriosAvaliacao        Json         @default("[]")
  // Tipos de anexo aceitos: [{ tipo: string, label: string, obrigatorio: boolean }]
  tiposAnexo                Json?
  // Nota mínima para classificação (null = sem corte). Escala 0-10.
  notaMinima                Decimal?     @db.Decimal(5, 2)
  // Regras de desempate: [{ descricao: string, tipo: 'bloco'|'criterio', ref: string, direcao: 'desc'|'asc' }]
  desempate                 Json?
  // Fórmula de cálculo da nota final (ex: "((B1+B2)/2)+B3"). Null = média ponderada padrão.
  formulaAvaliacao          String?
  // Versão acessível do edital em HTML (WCAG AA)
  conteudoAcessivel         String?
  // Número de vagas para contemplados (null = ilimitado)
  vagasContemplados         Int?
  // Número de vagas para suplentes (null = todos restantes com nota)
  vagasSuplentes            Int?
  // Libera a etapa opcional de inscrição por vídeo (substitui o preenchimento
  // manual das etapas customizadas por um vídeo único, ou aceita vídeo
  // complementar opcional junto do preenchimento manual)
  videoHabilitado           Boolean      @default(false)
  // Data real de publicação (preenchida quando status sai de RASCUNHO)
  publishedAt               DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  arquivos   ArquivoEdital[]
  inscricoes Inscricao[]
  faqItems   FaqItem[]
  membros    EditalMembro[]
}

model ArquivoEdital {
  id        String   @id @default(cuid())
  editalId  String
  tipo      String // PDF | ANEXO | MODELO | PLANILHA | DECLARACAO
  titulo    String
  url       String
  acessivel Boolean  @default(false)
  createdAt DateTime @default(now())

  edital Edital @relation(fields: [editalId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// Inscrições / Propostas
// ─────────────────────────────────────────────────────────────────────────────

model Inscricao {
  id                 String          @id @default(cuid())
  numero             String          @unique
  editalId           String
  proponenteId       String
  status             InscricaoStatus @default(RASCUNHO)
  categoria          String?
  // Chaves das cotas (edital.categoriasConfig[].cotas[].key) que o proponente optou por concorrer
  cotasOptIn         String[]        @default([])
  // Campos dinâmicos preenchidos pelo proponente
  campos             Json            @default("{}")
  orcamento          Json?
  notaFinal          Decimal?        @db.Decimal(5, 2)
  posicao            Int?
  motivoInabilitacao String?
  // Optou por substituir o preenchimento manual das etapas customizadas
  // por um vídeo único (etapa "video" do wizard de inscrição)
  submissaoPorVideo  Boolean         @default(false)
  submittedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  edital         Edital           @relation(fields: [editalId], references: [id])
  proponente     User             @relation(fields: [proponenteId], references: [id])
  anexos         AnexoInscricao[]
  avaliacoes     Avaliacao[]
  recursos       Recurso[]
  projetoApoiado ProjetoApoiado?
}

model AnexoInscricao {
  id          String   @id @default(cuid())
  inscricaoId String
  tipo        String
  titulo      String
  url         String
  valido      Boolean?
  observacao  String?
  createdAt   DateTime @default(now())

  inscricao Inscricao @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// Avaliação
// ─────────────────────────────────────────────────────────────────────────────

model Avaliacao {
  id          String   @id @default(cuid())
  inscricaoId String
  avaliadorId String
  // { criterio: string, nota: number, peso?: number }[]
  notas       Json     @default("[]")
  parecer     String?
  notaTotal   Decimal? @db.Decimal(5, 2)
  finalizada  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inscricao Inscricao @relation(fields: [inscricaoId], references: [id])
  avaliador User      @relation(fields: [avaliadorId], references: [id])

  @@unique([inscricaoId, avaliadorId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Recursos
// ─────────────────────────────────────────────────────────────────────────────

model Recurso {
  id            String    @id @default(cuid())
  inscricaoId   String
  fase          String // HABILITACAO | RESULTADO_PRELIMINAR | RESULTADO_FINAL
  texto         String
  urlAnexos     String[]
  decisao       String? // DEFERIDO | INDEFERIDO (consolidado)
  justificativa String?
  decididoPor   String? // CONSENSO | ADMIN
  createdAt     DateTime  @default(now())
  decidedAt     DateTime?

  inscricao Inscricao         @relation(fields: [inscricaoId], references: [id])
  respostas RecursoResposta[]
}

model RecursoResposta {
  id            String   @id @default(cuid())
  recursoId     String
  avaliadorId   String
  decisao       String // DEFERIDO | INDEFERIDO
  justificativa String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  recurso   Recurso @relation(fields: [recursoId], references: [id], onDelete: Cascade)
  avaliador User    @relation(fields: [avaliadorId], references: [id])

  @@unique([recursoId, avaliadorId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Transparência
// ─────────────────────────────────────────────────────────────────────────────

model ProjetoApoiado {
  id             String   @id @default(cuid())
  inscricaoId    String   @unique
  valorAprovado  Decimal  @db.Decimal(12, 2)
  statusExecucao String   @default("EM_EXECUCAO")
  contrapartida  String?
  mediaUrls      String[]
  relatorios     Json?
  publicado      Boolean  @default(false)
  createdAt      DateTime @default(now())

  inscricao Inscricao @relation(fields: [inscricaoId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Conteúdo CMS
// ─────────────────────────────────────────────────────────────────────────────

model Noticia {
  id          String    @id @default(cuid())
  titulo      String
  slug        String    @unique
  corpo       String
  tags        String[]
  imagemUrl   String?
  publicado   Boolean   @default(false)
  publicadoEm DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Manual {
  id        String   @id @default(cuid())
  titulo    String
  categoria String
  url       String
  versao    String?
  publicado Boolean  @default(true)
  createdAt DateTime @default(now())
}

model FaqItem {
  id        String   @id @default(cuid())
  editalId  String?
  pergunta  String
  resposta  String
  ordem     Int      @default(0)
  publicado Boolean  @default(true)
  createdAt DateTime @default(now())

  edital Edital? @relation(fields: [editalId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// CMS — Páginas Institucionais
// ─────────────────────────────────────────────────────────────────────────────

model CmsPage {
  id        String   @id @default(cuid())
  titulo    String
  slug      String   @unique
  corpo     String // HTML do editor rich text
  publicado Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Slides de Destaque (Carrossel da Home)
// ─────────────────────────────────────────────────────────────────────────────

model SlideDestaque {
  id        String    @id @default(cuid())
  titulo    String
  descricao String?
  imagemUrl String?
  ctaLabel  String?
  ctaUrl    String?
  ordem     Int       @default(0)
  ativo     Boolean   @default(true)
  inicioEm  DateTime?
  fimEm     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Equipe do Edital — Avaliadores e Habilitadores atribuídos
// ─────────────────────────────────────────────────────────────────────────────

model EditalMembro {
  id        String       @id @default(cuid())
  editalId  String
  userId    String
  funcao    FuncaoEdital
  createdAt DateTime     @default(now())

  edital Edital @relation(fields: [editalId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([editalId, userId, funcao])
  @@index([editalId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Tipos de Anexo (individuais, com tag/grupo)
// ─────────────────────────────────────────────────────────────────────────────

model AttachmentType {
  id          String   @id @default(cuid())
  tipo        String   @unique // ID interno (ex: DOCUMENTO_PESSOAL)
  label       String // Nome visível (ex: Documento Pessoal)
  obrigatorio Boolean  @default(false)
  tag         String // Grupo (ex: "PNAB", "Cultura Viva")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tag])
}

// ─────────────────────────────────────────────────────────────────────────────
// Categorias Culturais
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  nome      String   @unique
  slug      String   @unique
  descricao String?
  ativa     Boolean  @default(true)
  isSystem  Boolean  @default(false)
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ativa])
  @@index([ordem])
}

// ─────────────────────────────────────────────────────────────────────────────
// Templates de Avaliação
// ─────────────────────────────────────────────────────────────────────────────

model EvaluationTemplate {
  id        String   @id @default(cuid())
  nome      String   @unique
  descricao String?
  criterios Json     @default("[]")
  formula   String?
  isSystem  Boolean  @default(false)
  ativo     Boolean  @default(true)
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ativo])
  @@index([ordem])
}

// ─────────────────────────────────────────────────────────────────────────────
// Atendimento
// ─────────────────────────────────────────────────────────────────────────────

model Atendimento {
  id           String            @id @default(cuid())
  protocolo    String            @unique
  editalId     String?
  autorId      String?
  nomeContato  String
  emailContato String
  telefone     String?
  assunto      String
  mensagem     String
  status       AtendimentoStatus @default(ABERTO)
  // [{ de: string, texto: string, criadoEm: string }]
  historico    Json[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  autor User? @relation(fields: [autorId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notificações — disparos manuais, regras automáticas, entregas individuais
// ─────────────────────────────────────────────────────────────────────────────

model NotificationCampaign {
  id           String                @id @default(cuid())
  tipo         CampaignType          @default(MANUAL)
  status       CampaignStatus        @default(RASCUNHO)
  titulo       String
  assunto      String
  corpo        String                @db.Text
  link         String?
  ctaLabel     String?
  canais       NotificationChannel[] @default([IN_APP])
  // Filtro de audiência (snapshot do que foi escolhido na criação)
  filtro       Json                  @default("{}")
  scheduledAt  DateTime?
  sentAt       DateTime?
  totalAlvo    Int                   @default(0)
  totalEnviado Int                   @default(0)
  totalErro    Int                   @default(0)
  ruleId       String?
  createdById  String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  rule          NotificationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  createdBy     User?             @relation("CampaignCreatedBy", fields: [createdById], references: [id])
  notifications Notification[]

  @@index([status])
  @@index([createdAt])
  @@index([ruleId])
}

model NotificationRule {
  id          String                  @id @default(cuid())
  nome        String
  descricao   String?
  trigger     NotificationRuleTrigger
  ativo       Boolean                 @default(false)
  // Configuração específica do trigger (ex: { horas: 24, editalIds: [...] })
  config      Json                    @default("{}")
  assunto     String
  corpo       String                  @db.Text
  link        String?
  ctaLabel    String?
  canais      NotificationChannel[]   @default([IN_APP])
  filtro      Json                    @default("{}")
  createdById String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  createdBy User?                  @relation("RuleCreatedBy", fields: [createdById], references: [id])
  campaigns NotificationCampaign[]

  @@index([trigger, ativo])
}

model Notification {
  id             String                @id @default(cuid())
  userId         String
  campaignId     String?
  titulo         String
  corpo          String                @db.Text
  link           String?
  ctaLabel       String?
  canais         NotificationChannel[] @default([IN_APP])
  lidaEm         DateTime?
  emailEnviadoEm DateTime?
  emailErro      String?
  createdAt      DateTime              @default(now())

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign NotificationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([campaignId, userId])
  @@index([userId, lidaEm])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Templates de e-mail — overrides editáveis pelo admin
// ─────────────────────────────────────────────────────────────────────────────
// O fallback continua sendo o componente React Email em src/lib/mail/templates/.
// Esta tabela só guarda overrides — quando enabled=true para um `key`, o
// renderTemplate usa subject/body daqui (com substituição de {{placeholder}})
// envolto no Layout compartilhado. Senão, renderiza o componente React.
//
// `key` é a string da união EmailTemplate (ex: "recuperacao_senha"). Mantido
// como String em vez de enum porque o tipo TS é a fonte da verdade e enums
// Prisma são mais rígidos pra evoluir.

model EmailTemplateOverride {
  id          String   @id @default(cuid())
  key         String   @unique
  subject     String
  body        String   @db.Text
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation("EmailTemplateUpdatedBy", fields: [updatedById], references: [id])

  @@index([enabled])
}
