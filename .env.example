# App
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# URL pública absoluta da aplicação (usada em metadata/Open Graph).
# Em produção: https://culturaeturismo.irece.ba.gov.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Path prefix do Next.js — vazio em dev e em produção (subdomínio dedicado, sem basePath)
NEXT_PUBLIC_BASE_PATH=
# Mesmo valor de NEXT_PUBLIC_BASE_PATH — usado pelo healthcheck do docker-compose
BASE_PATH=
# Origens permitidas no CORS da API v1 (separadas por vírgula)
API_CORS_ORIGINS=
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=gere-e-cole-aqui

# Database (usar nomes dos serviços do Docker Compose em produção)
POSTGRES_USER=pnab
POSTGRES_PASSWORD=pnab_secret
POSTGRES_DB=pnab_irece
DATABASE_URL=postgresql://pnab:pnab_secret@localhost:5433/pnab_irece
# Para dev local sem Docker: DATABASE_URL=postgresql://pnab:pnab_secret@localhost:5433/pnab_irece

# Redis (usar nome do serviço do Docker Compose em produção)
REDIS_URL=redis://localhost:6379
# Para dev local sem Docker: REDIS_URL=redis://localhost:6379

# Supabase Storage
SUPABASE_URL=https://sgbakvmjihrwtukvaczz.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNnYmFrdm1qaWhyd3R1a3ZhY3p6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzI1NzQ1NjcsImV4cCI6MjA4ODE1MDU2N30.gSKw1sMe_-67Sw96wcHQejSCAs6X8i0JZt6YP-nCWtQ
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNnYmFrdm1qaWhyd3R1a3ZhY3p6Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3MjU3NDU2NywiZXhwIjoyMDg4MTUwNTY3fQ.rVme4jzU4oe2zcWVmHG27EBqedsj1n1Eh40w3hppdIs

# E-mail transacional — Resend (https://resend.com)
# API key do projeto. Gere em https://resend.com/api-keys (escopo de envio basta).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Remetente — domínio precisa estar verificado na conta Resend.
EMAIL_FROM="Portal PNAB Irecê <noreply@culturaeturismo.irece.ba.gov.br>"

# Allowlist de testes — CSV de e-mails permitidos.
# Quando setada, `sendEmail` SÓ dispara pra endereços nesta lista (case-insensitive).
# Demais destinatários viram no-op silencioso com log `event=email_skipped_by_allowlist`.
# Útil em staging/UAT pra exercitar fluxos sem mandar email pra usuário real.
# Em produção: deixar vazia (sem restrição).
# Ex.: EMAIL_TEST_ALLOWLIST=teste777.65@gmail.com,loki10ms@gmail.com
EMAIL_TEST_ALLOWLIST=

# Notificações — kill switch do canal email
# Quando 'false', notificações marcadas pra Email viram no-op silencioso (emailErro="disabled").
# Trocar pra 'true' apenas quando o domínio do remetente estiver verificado no Resend.
NOTIFICATION_EMAIL_ENABLED=false

# Sentry (monitoramento de erros)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Auditoria
AUDIT_RETENTION_DAYS=365

# CNPJ Lookup (opcional — defaults públicos já configurados no código)
# BRASILAPI_CNPJ_URL=https://brasilapi.com.br/api/cnpj/v1/
# RECEITAWS_CNPJ_URL=https://receitaws.com.br/v1/cnpj/

# =====================================================================
# CONFIG POR FORK (cada cidade/secretaria personaliza aqui)
# =====================================================================
# Este projeto é distribuído por fork. Cada município/secretaria que adota
# clona o repo e ajusta os valores abaixo — sem mexer em src/.

# --- Identidade da prefeitura/secretaria ---
NEXT_PUBLIC_BRANDING_NOME_CURTO="Portal PNAB Irecê"
NEXT_PUBLIC_BRANDING_NOME_LONGO="Portal PNAB — Prefeitura de Irecê"
NEXT_PUBLIC_BRANDING_PREFEITURA="Prefeitura Municipal de Irecê"
NEXT_PUBLIC_BRANDING_SECRETARIA="Secretaria Municipal de Arte e Cultura"
NEXT_PUBLIC_BRANDING_MUNICIPIO_SLUG="irece-ba"
NEXT_PUBLIC_BRANDING_UF="BA"

# --- Identidade visual ---
# Cores em hex, sem hash. Aplicadas via CSS vars no layout root.
NEXT_PUBLIC_BRANDING_COR_PRIMARIA=1f4d7a
NEXT_PUBLIC_BRANDING_COR_SECUNDARIA=e9a23b
NEXT_PUBLIC_BRANDING_COR_ACENTO=c0392b
# Caminhos para assets em public/branding/ — o fork substitui os arquivos lá.
NEXT_PUBLIC_BRANDING_LOGO=/branding/logo.svg
NEXT_PUBLIC_BRANDING_LOGO_DARK=/branding/logo-dark.svg
NEXT_PUBLIC_BRANDING_FAVICON=/branding/favicon.ico
NEXT_PUBLIC_BRANDING_BRASAO=/branding/brasao.png

# --- Contato institucional (aparece no footer e contato) ---
NEXT_PUBLIC_CONTATO_EMAIL=cultura@irece.ba.gov.br
NEXT_PUBLIC_CONTATO_TELEFONE="(74) 0000-0000"
NEXT_PUBLIC_CONTATO_ENDERECO="Praça XYZ, s/n — Centro, Irecê/BA"
NEXT_PUBLIC_CONTATO_INSTAGRAM=
NEXT_PUBLIC_CONTATO_FACEBOOK=

# --- Módulos habilitados nesta cópia ---
# true/false. Módulos desligados ocultam menu/rotas e bloqueiam endpoints.
NEXT_PUBLIC_MODULO_EDITAIS=true
NEXT_PUBLIC_MODULO_CMS=true
NEXT_PUBLIC_MODULO_NOTICIAS=true
NEXT_PUBLIC_MODULO_NOTIFICACOES=true
NEXT_PUBLIC_MODULO_ATENDIMENTOS=true
NEXT_PUBLIC_MODULO_TRANSPARENCIA=true

# --- Acessibilidade ---
NEXT_PUBLIC_VLIBRAS_HABILITADO=true
